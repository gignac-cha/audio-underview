{
  "name": "@audio-underview/share-viewer",
  "version": "1.0.0",
  "description": "Read-only public share viewer for Audio Underview newscasts",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.functions.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.functions.json",
    "test:watch": "vitest"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@audio-underview/newscast-core": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:worker",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
