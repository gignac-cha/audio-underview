# applications/web — Vite 빌드타임 환경변수 (import.meta.env)
# 로컬 개발 시 이 파일을 `.env`로 복사하거나 `pnpm environment:generate`로 생성한다.

# 단일 authentication-worker (OAuth authorize/callback/tokens/providers)
VITE_AUTHENTICATION_WORKER_URL=https://audio-underview-authentication-worker.example.workers.dev

# crawler CRUD API
VITE_CRAWLER_MANAGER_WORKER_URL=https://audio-underview-crawler-manager-worker.example.workers.dev

# scheduler / stage / run API
VITE_SCHEDULER_MANAGER_WORKER_URL=https://audio-underview-scheduler-manager-worker.example.workers.dev

# 크롤러 코드 테스트 실행 (AWS Lambda Function URL — Bearer JWT 필요)
VITE_CRAWLER_CODE_RUNNER_FUNCTION_URL=https://example.lambda-url.ap-northeast-2.on.aws
