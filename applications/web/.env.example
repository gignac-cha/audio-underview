# The addresses of the local workers are in .env.development (committed), so only the secret
# value below is yours to set. Put it in .env.development.local, which is gitignored and read
# only by the dev server. `pnpm environment:generate` writes that file from 1Password.

# Google OAuth Client ID
# Get this from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
