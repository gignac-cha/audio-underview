# Addresses of the local workers that `pnpm dev` starts. Nothing here is secret, and Vite reads this
# file only in development mode (the dev server), never in a build.
VITE_GOOGLE_OAUTH_WORKER_URL=http://localhost:8787
VITE_GITHUB_OAUTH_WORKER_URL=http://localhost:8788
VITE_CRAWLER_MANAGER_WORKER_URL=http://localhost:8789
VITE_SCHEDULER_MANAGER_WORKER_URL=http://localhost:8790
