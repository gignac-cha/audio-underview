# authentication-worker + manager worker secret 주입용 (`wrangler secret put` 소스)
# 로컬 개발/배포 시 `pnpm environment:generate`로 1Password에서 생성한다.
# 이 파일은 repo가 자동으로 읽지 않는다 — 수동으로 source하거나 secret 등록에 사용.

# --- 공통 (authentication / crawler-manager / scheduler-manager) ---
JWT_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
FRONTEND_URL=https://audio-underview.pages.dev
ALLOWED_ORIGINS=http://localhost:5173,https://audio-underview.pages.dev

# --- OAuth provider 10개 (authentication-worker에 주입) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# KAKAO_CLIENT_ID는 REST API Key, CLIENT_SECRET은 선택 (콘솔 설정에 따라)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
