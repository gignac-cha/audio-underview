{
  "name": "audio-underview",
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "environment:setup": "pnpm --filter @audio-underview/environment-generator run setup",
    "environment:generate": "pnpm --filter @audio-underview/environment-generator run generate"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.26.1",
  "type": "module",
  "engines": {
    "node": ">=25.2.1"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
